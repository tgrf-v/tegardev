{
  "name": "tegardev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tegardev-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tegardev-db --remote",
    "db:seed:local": "wrangler d1 execute tegardev-db --local --file=./drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute tegardev-db --remote --file=./drizzle/seed.sql",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.157.0"
  }
}
